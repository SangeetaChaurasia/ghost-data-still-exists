# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Required for live LLM / vision calls. Without it the agent runs from the
# committed response cache (code/cache/) and rule-based fallbacks.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4.1-mini          # request-intent classification
# OPENAI_VISION_MODEL=gpt-4.1        # screenshot evidence extraction
# OPENAI_BASE_URL=                   # e.g. an Azure/OpenAI-compatible gateway
# OPENAI_TIMEOUT=60                  # seconds per API request
# GHOST_PROMPTS_DIR=                 # alternative prompts folder (default: code/prompts, then prompts/)
# LLM_PRICE_GPT_4_1_MINI=0.40,1.60   # USD per 1M input,output tokens for the usage report
